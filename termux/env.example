# Local Termux llama.cpp server (no provider API key required)
NEXUS_BASE_URL=http://localhost:8088
NEXUS_LOCAL_BASE_URL=http://localhost:8088
NEXUS_MODEL_PATH=$HOME/models/your-model.gguf
NEXUS_SERVER_PORT=8088
NEXUS_SERVER_CTX=4096
NEXUS_SERVER_THREADS=4
NEXUS_GPU_LAYERS=0

# Optional self-hosted HTTPS inference/orchestrator on a separate machine.
# Leave blank until you own and configure such a server.
NEXUS_REMOTE_BASE_URL=
NEXUS_API_KEY=

# Optional override for the generated Termux localhost pairing token.
# Normally leave blank; Termux creates a random 48-byte token in its private state directory.
NEXUS_LOCAL_API_KEY=
