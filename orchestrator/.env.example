# Copy to .env locally; never commit real secrets.
NEXUS_API_KEY=replace-with-a-long-random-secret
NEXUS_AGENTS_JSON={}
NEXUS_DEFAULT_TIMEOUT_SECONDS=45
NEXUS_MAX_AGENTS=12
NEXUS_MAX_REVIEW_ROUNDS=2
NEXUS_MAX_REQUEST_CHARS=30000
NEXUS_ALLOW_LOCAL_HTTP=0  # set to 1 only for loopback development endpoints
NEXUS_SYNTHESIS_AGENT=
